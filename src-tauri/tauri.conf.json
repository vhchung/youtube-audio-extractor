{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Audio Extract",
  "version": "1.0.1",
  "identifier": "com.ytaudio.extract",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube Audio Extract",
        "width": 1100,
        "height": 860,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://localhost:1420; img-src 'self' https://i.ytimg.com data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server/pyproject.toml": "server/pyproject.toml",
      "../server/.python-version": "server/.python-version",
      "../server/uv.lock": "server/uv.lock",
      "../server/app/**/*": "server/app/"
    }
  }
}
